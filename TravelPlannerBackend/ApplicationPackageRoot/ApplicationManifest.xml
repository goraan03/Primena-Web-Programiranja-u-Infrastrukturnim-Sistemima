<?xml version="1.0" encoding="utf-8"?>
<ApplicationManifest xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" ApplicationTypeName="TravelPlannerBackendType" ApplicationTypeVersion="1.0.0" xmlns="http://schemas.microsoft.com/2011/01/fabric">
  <Parameters>
    <Parameter Name="BackendAPI_InstanceCount" DefaultValue="-1" />
    <Parameter Name="AuthService_InstanceCount" DefaultValue="-1" />
    <Parameter Name="TravelService_InstanceCount" DefaultValue="-1" />
    <Parameter Name="NotificationService_MinReplicaSetSize" DefaultValue="1" />
    <Parameter Name="NotificationService_TargetReplicaSetSize" DefaultValue="1" />
  </Parameters>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="BackendAPIPkg" ServiceManifestVersion="1.0.0" />
  </ServiceManifestImport>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="AuthServicePkg" ServiceManifestVersion="1.0.0" />
  </ServiceManifestImport>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="TravelServicePkg" ServiceManifestVersion="1.0.0" />
  </ServiceManifestImport>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="NotificationServicePkg" ServiceManifestVersion="1.0.0" />
  </ServiceManifestImport>
  <DefaultServices>
    <Service Name="BackendAPI" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="BackendAPIType" InstanceCount="[BackendAPI_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
    <Service Name="AuthService" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="AuthServiceType" InstanceCount="[AuthService_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
    <Service Name="TravelService" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="TravelServiceType" InstanceCount="[TravelService_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
    <Service Name="NotificationService" ServicePackageActivationMode="ExclusiveProcess">
      <StatefulService ServiceTypeName="NotificationServiceType" TargetReplicaSetSize="[NotificationService_TargetReplicaSetSize]" MinReplicaSetSize="[NotificationService_MinReplicaSetSize]">
        <SingletonPartition />
      </StatefulService>
    </Service>
  </DefaultServices>
</ApplicationManifest>