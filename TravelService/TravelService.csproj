<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsServiceFabricServiceProject>True</IsServiceFabricServiceProject>
    <ServerGarbageCollection>True</ServerGarbageCollection>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>True</SelfContained>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.30" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.30" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.ServiceFabric.Services.Remoting" Version="8.6.239" />
		<PackageReference Include="Microsoft.ServiceFabric.Services" Version="8.6.239" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TravelPlanner.Contracts\TravelPlanner.Contracts.csproj" />
  </ItemGroup>

</Project>
